# MySQL 配置
MYSQL_HOST=192.168.3.12
MYSQL_PORT=3306
MYSQL_DATABASE=blog
MYSQL_USERNAME=lam
MYSQL_PASSWORD=123456
MYSQL_CHARSET=utf8

# Redis 配置
REDIS_HOST=192.168.3.12
REDIS_PORT=6379
REDIS_PASSWORD=123456
REDIS_DB=0

# 股票数据API配置
STOCK_API_URL=https://gushitong.baidu.com/opendata

# PHP后端交易接口
PHP_API_URL=yaf.local

# 服务配置
ORDER_CHECK_INTERVAL=10       # 委托检查间隔(秒) - 每10秒用缓存价格检查委托
PRICE_UPDATE_INTERVAL=300     # 百度API价格获取间隔(秒) - 每5分钟获取一次价格数据
CLEANUP_INTERVAL=3600      # 清理间隔(秒)
MAX_CONCURRENT_CHECKS=10   # 最大并发检查数
LOG_LEVEL=info             # 日志级别: debug, info, warn, error

# HTTP服务配置
HTTP_PORT=8080
HTTP_READ_TIMEOUT=30
HTTP_WRITE_TIMEOUT=30